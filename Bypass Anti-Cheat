local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Core = ReplicatedStorage:WaitForChild("Core")
local Events = ReplicatedStorage:WaitForChild("Events")
local CheatCheck = Core:WaitForChild("System"):WaitForChild("CheatCheck")
local DataRemote = Events:WaitForChild("DataRemote")

local CheatCheckTable = require(CheatCheck)

if CheatCheckTable then
    if CheatCheckTable.Scan then
        hookfunction(CheatCheckTable.Scan, function()
            return {}
        end)
    end

    if CheatCheckTable.Run then
        hookfunction(CheatCheckTable.Run, function()
            return nil
        end)
    end
end

local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", function(Self, ...)
    local Method = getnamecallmethod()
    local Args = {...}
    
    if Self == DataRemote and (Method == "InvokeServer" or Method == "invokeServer") and Args[1] == "ReportCheat" then
        return nil
    end
    
    return OldNamecall(Self, ...)
end)

					local n = tostring(m and m.Name or p.Name)
					if n:find("RoundEnder", 1, true) then
						local key = tostring(p)
						if not seen[key] then
							seen[key] = true
							table.insert(list, p)
						end
					end
				end
			end
		end
		return list
	end

	local function collectExitsAll()
		local list = {}

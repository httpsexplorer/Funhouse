local SAFE = 50
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function HasLos(fromPos, toPos)
	local r = Root()
	local ignore = {}
	if r and r.Parent then table.insert(ignore, r.Parent) end
	if Char() then table.insert(ignore, Char()) end
	RayParams.FilterDescendantsInstances = ignore
	local dir = toPos - fromPos
	local dist = dir.Magnitude
	if dist < 1 then return true end
	local result = Workspace:Raycast(fromPos, dir.Unit * dist, RayParams)
	if not result then return true end
	return (result.Position - toPos).Magnitude < 4
end

local function CryptidNear(pos, rad, needLos)
	rad = rad or SAFE
	for _, o in ipairs(Workspace:GetDescendants()) do
		if StinkyCryptid(o) then
			local p = Part(o)
			if p and (p.Position - pos).Magnitude <= rad then
				if needLos then
					local origin = pos + Vector3.new(0, 2, 0)
					local target = p.Position + Vector3.new(0, 2, 0)
					if HasLos(origin, target) then
						return true, o.Name
					end
				else
					return true, o.Name
				end
			end
		end
	end
	return false
end

local function FrontOf(part, dist)
	dist = dist or 5
	local cf = part.CFrame
	return cf.Position + cf.LookVector * dist + Vector3.new(0, 2, 0), cf.LookVector
end

local function SoftTP(pos, look)
	local r = Root()
	if not r then return false end
	pcall(function()
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		if look then
			r.CFrame = CFrame.lookAt(pos, pos + look)
		else
			r.CFrame = CFrame.new(pos)
		end
	end)
	return true
end

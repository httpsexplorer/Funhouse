			local p = exitQueue[exitQi]
			exitQi = exitQi + 1
			if exitQi > #exitQueue then
				exitQi = 1
				exitQueue = collectExitsAll()
			end
			return p
		end
		local best, bd = nil, math.huge
		for _, p in ipairs(list) do
			local d = (p.Position - rp).Magnitude
			if d < bd then best, bd = p, d end
		end
		return best
	end


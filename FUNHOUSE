Run("Fun", function()
	local t = Tab("Fun", "Just for fun", "solar:smile-circle-bold")
	local s = Sec(t, "Dialogue", "bubbles", "solar:chat-round-dots-bold")
	local txt, auto = "", false
	local function say(msg, dur)
		dur = dur or 4
		msg = tostring(msg or "")
		if msg == "" then return false end
		local c = Char()
		if not c then return false end
		local bubble = c:FindFirstChild("ChatBubble")
		if not bubble then Ping("Dialogue", "no bubble rn", 2) return false end
		local frame = bubble:FindFirstChild("Frame")
		local message = frame and frame:FindFirstChild("Message")
		if not frame or not message then return false end
		local head = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
		if head then bubble.Adornee = head end
		message.Text = msg
		bubble.Enabled = true
		frame.BackgroundTransparency = 0
		message.TextTransparency = 0
		task.delay(dur, function()
			if bubble and bubble.Parent then
				bubble.Enabled = false
				message.Text = ""
				message.TextTransparency = 1
				frame.BackgroundTransparency = 1
			end
		end)
		return true
	end
	Add(s, "Input", { Title = "Dialogue Text", Placeholder = "Type...", Value = "", Callback = function(v) txt = tostring(v or "") end })
	Add(s, "Button", { Title = "Say Dialogue", Icon = "message-circle", Callback = function()
		if txt == "" then Ping("Dialogue", "write something first", 2) return end
		say(txt, 4)
	end })
	Add(s, "Toggle", { Title = "Chat as Bubble", Desc = "your chat shows as a bubble", Value = false, Callback = function(v) auto = v end })
	pcall(function()
		Me.Chatted:Connect(function(msg)
			if auto and msg ~= "" then say(msg, 4) end
		end)
	end)
end)


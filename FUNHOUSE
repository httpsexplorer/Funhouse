	local function softClick(worldPos)
		local cam = Workspace.CurrentCamera
		if not cam then return end
		local v, onScreen = cam:WorldToViewportPoint(worldPos)
		if not onScreen then return end
		local vim = game:GetService("VirtualInputManager")
		pcall(function()
			if vim and vim.SendMouseButtonEvent then
				vim:SendMouseButtonEvent(v.X, v.Y, 0, true, game, 0)
				vim:SendMouseButtonEvent(v.X, v.Y, 0, false, game, 0)
			end
		end)
		pcall(function()
			if vim and vim.SendKeyEvent then
				vim:SendKeyEvent(true, Enum.KeyCode.ButtonA, false, game)
				vim:SendKeyEvent(false, Enum.KeyCode.ButtonA, false, game)
			end
		end)
	end

	local function findSnuggles()
		for _, o in ipairs(Workspace:GetChildren()) do
			if o:IsA("Model") then
				local n = o.Name
				if n == "Snuggles" or n:find("Snuggle") then
					local p = Part(o)
					if p then return o, p end
				end
			end
		end
		return nil, nil
	end

	local function findTripletClones()
		local list = {}
		for _, o in ipairs(Workspace:GetChildren()) do
			if o:IsA("Model") then
				local n = o.Name
				if n:find("Triplet") or n:find("Piglet") or n:find("triplet") then
					local p = Part(o)
					if p and (p.Position - (Root() and Root().Position or p.Position)).Magnitude < 40 then
						table.insert(list, { O = o, P = p })
					end
				end
			end
		end
		return list
	end

	local function startGhostCam()
		if ghostConn then return end
		Cam = Workspace.CurrentCamera
		if not Cam then return end
		savedCamType = Cam.CameraType
		pcall(function() Cam.CameraType = Enum.CameraType.Scriptable end)
		ghostConn = RunService.RenderStepped:Connect(function()
			if not ghostCam then return end
			local cam = Workspace.CurrentCamera
			if not cam then return end
			local r = Root()
			if not r then return end
			local _, snP = findSnuggles()
			local aim = snP and snP.Position or nil
			if not aim then
				local trips = findTripletClones()
				if #trips > 0 then aim = trips[1].P.Position end
			end
			if aim then
				local base = r.CFrame * CFrame.new(0, 2.5, 8)
				cam.CFrame = CFrame.lookAt(base.Position, aim)
			else
				cam.CFrame = CFrame.new(r.Position + Vector3.new(0, 3, 10), r.Position)
			end
		end)
		Hook(ghostConn)
	end

	local function stopGhostCam()
		if ghostConn then
			ghostConn:Disconnect()
			ghostConn = nil
		end
		Cam = Workspace.CurrentCamera
		if Cam and savedCamType then
			pcall(function() Cam.CameraType = savedCamType end)
		end
	end


local Loops, Hooks = {}, {}
local function Loop(k, pred, fn, wait)
	if Loops[k] then return end
	Loops[k] = true
	task.spawn(function()
		while Loops[k] and pred() do
			pcall(fn)
			task.wait(wait)
		end
		Loops[k] = nil
	end)
end
local function Stop(k) Loops[k] = nil end
local function Hook(c)
	if c then table.insert(Hooks, c) end
	return c
end

